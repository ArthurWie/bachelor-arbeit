# Basis-URL der lokalen Zotero-API (Zotero muss laufen; Settings -> Advanced ->
# "Allow other applications on this computer to communicate with Zotero")
ZOTERO_BASE_URL=http://localhost:23119

# Pfad zur SQLite-Datenbank
DB_PATH=library.db

# Cache-Verzeichnis für HuggingFace-Modelle (leer = HF-Default ~/.cache/huggingface)
MODEL_CACHE=
